class ChoreographerError(ValueError):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code


def fail(code: str, message: str) -> None:
    raise ChoreographerError(code, message)


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def pretty_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_ref(data: bytes) -> str:
    return "sha256:" + sha256_hex(data)


def content_id(prefix: str, value: Any) -> str:
    return f"{prefix}_{sha256_hex(canonical_bytes(value))}"


def exact_keys(value: Any, expected: Iterable[str], code: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        fail(code, "object required")
    wanted = set(expected)
    observed = set(value)
    if observed != wanted:
        fail(code, f"missing={sorted(wanted-observed)} extra={sorted(observed-wanted)}")
    return value


def assert_no_forbidden(value: Any, path: str = "$") -> None:
    if isinstance(value, list):
        if len(value) > 4096:
            fail("ARRAY_LIMIT_EXCEEDED", path)
        for index, row in enumerate(value):
            assert_no_forbidden(row, f"{path}[{index}]")
        return
    if not isinstance(value, dict):
        return
    for key, row in value.items():
        if key in FORBIDDEN_KEYS:
            fail("FORBIDDEN_FIELD", f"{path}.{key}")
        assert_no_forbidden(row, f"{path}.{key}")


def string_value(value: Any, name: str, pattern: re.Pattern[str] | None = None, maximum: int = 256) -> str:
    if not isinstance(value, str) or not 1 <= len(value) <= maximum or any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        fail("STRING_INVALID", name)
    if pattern and not pattern.fullmatch(value):
        fail("STRING_PATTERN_INVALID", name)
    if re.match(r"^(?:https?|wss?|file):", value, re.I) or re.match(r"^[A-Za-z]:[\\/]", value) or value.startswith("\\\\"):
        fail("RAW_COORDINATE_FORBIDDEN", name)
    if re.fullmatch(r"(?:\d{1,3}\.){3}\d{1,3}(?::\d+)?", value):
        fail("RAW_NETWORK_IDENTITY_FORBIDDEN", name)
    return value


def sha_value(value: Any, name: str) -> str:
    return string_value(value, name, SHA_RE, 71)


def integer_value(value: Any, name: str, minimum: int = 0, maximum: int = 2**53 - 1) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
        fail("INTEGER_REQUIRED", name)
    return value


def boolean_value(value: Any, name: str) -> bool:
    if not isinstance(value, bool):
        fail("BOOLEAN_REQUIRED", name)
    return value


def load_json(path: Path, maximum: int) -> tuple[dict[str, Any], bytes]:
    data = inspect_regular(path, maximum)
    try:
        value = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        fail("JSON_INVALID", f"{path}: {exc}")
    if not isinstance(value, dict):
        fail("JSON_OBJECT_REQUIRED", str(path))
    return value, data


def inspect_regular(path: Path, maximum: int, *, allow_empty: bool = False) -> bytes:
    absolute = Path(os.path.abspath(path))
    current = Path(absolute.parts[0])
    for part in absolute.parts[1:]:
        current = current / part
        if not current.exists() and not current.is_symlink():
            continue
        info = current.lstat()
        if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400):
            fail("LINKED_PATH_REFUSED", str(current))
    try:
        info = absolute.lstat()
    except OSError as exc:
        fail("INPUT_UNAVAILABLE", f"{absolute}: {exc}")
    if not stat.S_ISREG(info.st_mode) or info.st_size > maximum or (not allow_empty and info.st_size < 1):
        fail("INPUT_SIZE_OR_TYPE_INVALID", str(absolute))
    data = absolute.read_bytes()
    if len(data) != info.st_size:
        fail("INPUT_READ_INVALID", str(absolute))
    return data


def write_new(path: Path, data: bytes) -> None:
    absolute = Path(os.path.abspath(path))
    if absolute.exists() or absolute.is_symlink():
        fail("OUTPUT_ALREADY_EXISTS", str(absolute))
    absolute.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    fd = os.open(absolute, flags, 0o600)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        try:
            absolute.unlink()
        except OSError:
            pass
        raise


def require_new_directory(path: Path, forbidden_root: Path) -> Path:
    absolute = Path(os.path.abspath(path))
    forbidden = Path(os.path.abspath(forbidden_root))
    if absolute.exists() or absolute.is_symlink():
        fail("OUTPUT_ALREADY_EXISTS", str(absolute))
    try:
        absolute.relative_to(forbidden)
    except ValueError:
        pass
    else:
        fail("REPOSITORY_LOCAL_OUTPUT_REFUSED", str(absolute))
    current = Path(absolute.parts[0])
    for part in absolute.parts[1:]:
        current = current / part
        if current.exists() or current.is_symlink():
            info = current.lstat()
